{
  "name": "ajaysahuphysics-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/inject-csp.mjs out",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:build-output": "vitest run --config vitest.build.config.ts",
    "staging:check": "node scripts/staging/staging-env.mjs check",
    "test:staging": "node scripts/staging/staging-env.mjs run",
    "test:staging:browser": "node scripts/staging/staging-env.mjs check && node scripts/staging/browser-journey.mjs",
    "test:staging:deletion-gate": "node scripts/staging/staging-env.mjs check && node scripts/staging/deletion-gate.staging.mjs",
    "test:staging:release": "node scripts/staging/staging-env.mjs check && node scripts/staging/release-check.staging.mjs",
    "test:staging:verified-email": "node scripts/staging/staging-env.mjs check && node scripts/staging/verified-email.staging.mjs",
    "og:fonts": "node scripts/fetch-og-fonts.mjs",
    "og:generate": "node scripts/derive-og-sources.mjs && node scripts/generate-og-images.mjs",
    "test:e2e": "node scripts/e2e/study-tools.mjs out && node scripts/e2e/keyboard.mjs out",
    "test:e2e:firefox": "node scripts/e2e/run.mjs firefox out",
    "test:e2e:webkit": "node scripts/e2e/run.mjs webkit out"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
