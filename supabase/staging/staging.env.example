# ─────────────────────────────────────────────────────────────────
# STAGING-ONLY settings for `npm run staging:check` and `npm run test:staging`.
#
# 1. Copy this file to the REPOSITORY ROOT as:  .env.staging.local
#    That name is git-ignored (.gitignore: .env*), and Next.js never loads it
#    (it only loads .env, .env.local, .env.development*, .env.production*),
#    so nothing here can reach a website build.
# 2. Fill the values in your editor from the STAGING project's dashboard
#    (Project Settings → API Keys). Never paste them into a chat, an issue,
#    a PR or a commit.
# 3. Run `npm run staging:check`. It validates the file without connecting
#    to anything and prints no secret values.
#
# Production keys must never go in this file. The guard refuses the
# production project, and legacy keys issued for another project.
# ─────────────────────────────────────────────────────────────────

# Project URL: https://<staging-ref>.supabase.co
STAGING_SUPABASE_URL=

# Repeat the 20-character staging ref to confirm the target.
STAGING_CONFIRM_REF=

# Public key: sb_publishable_…  (or the legacy "anon" key)
STAGING_SUPABASE_PUBLISHABLE_KEY=

# Server key: sb_secret_…  (or the legacy "service_role" key)
# Used ONLY by the local test process; never a NEXT_PUBLIC_ variable.
STAGING_SUPABASE_SECRET_KEY=

# Optional: the sweep secret you set with `supabase secrets set` (staging).
STAGING_SWEEP_SECRET=

# Optional: only if staging CAPTCHA uses Cloudflare's TEST secret
# 1x0000000000000000000000000000000AA; then the test token is:
# STAGING_TURNSTILE_TEST_TOKEN=XXXX.DUMMY.TOKEN.XXXX
